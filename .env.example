# Copie este arquivo para .env e preencha os valores: cp .env.example .env
# Depois verifique tudo com: .venv/bin/python check_env.py

# --- IA (chat + embeddings) -------------------------------------------------
# Qualquer provedor compatível com a API da OpenAI. Exemplo com OpenRouter:
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-...
AI_MODEL=openrouter/free
# Para usar a OpenAI direto: apague AI_BASE_URL, use sua chave sk-... e AI_MODEL=gpt-4o-mini

# Modelo de embedding. No OpenRouter o nome leva o prefixo do provedor (openai/...).
# Na OpenAI direto, use apenas: text-embedding-3-small
EMBEDDING_MODEL=openai/text-embedding-3-small
# Dimensão dos vetores gerados pelo modelo. O índice do Pinecone precisa ter a MESMA dimensão.
EMBEDDING_DIM=1536

# --- Pinecone (banco de vetores) --------------------------------------------
PINECONE_API_KEY=pcsk_...
# Host do índice: aparece na página do índice no console do Pinecone
PINECONE_HOST=https://brito-ai-xxxxxxx.svc.xxxx-xxxx-xxxx.pinecone.io
PINECONE_INDEX_NAME=brito-ai
